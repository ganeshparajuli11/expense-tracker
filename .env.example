# Set automatically when you connect a Neon database in Vercel → Storage
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Password you type once on your phone to open the app
APP_PASSWORD=choose-a-strong-password

# Long random string; it becomes part of your Claude connector URL
# e.g. generate with: openssl rand -hex 24
MCP_SECRET=replace-with-a-long-random-string
